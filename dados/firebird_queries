SELECT rps.lote_codigo, COUNT(*) AS qt_notas_divergentes
  FROM NFSE_RPS rps
  JOIN NFSE_LOTE lot ON lot.lote_codigo = rps.lote_codigo
 WHERE lot.lote_data > CURRENT_TIMESTAMP - 4
   and lot.lote_protocolo IS NULL
   AND (EXTRACT(YEAR FROM rps_competencia)  <> EXTRACT(YEAR FROM CURRENT_TIMESTAMP)
    OR EXTRACT(MONTH FROM rps_competencia) <> EXTRACT(MONTH FROM CURRENT_TIMESTAMP)
    OR EXTRACT(DAY FROM rps_competencia)   <> EXTRACT(DAY FROM CURRENT_TIMESTAMP))
 GROUP BY rps.lote_codigo
 ORDER BY rps.lote_codigo

;

